options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: ''
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: complex_bandpass
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Making Complex Bandpass
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [32, 32.0]
    rotation: 0
    state: enabled

blocks:
- name: M
  id: variable
  parameters:
    comment: ''
    value: int((num_taps-1)/2)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [520, 48.0]
    rotation: 0
    state: enabled
- name: N
  id: variable
  parameters:
    comment: ''
    value: 2**12
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 136.0]
    rotation: 0
    state: enabled
- name: all_pass
  id: variable
  parameters:
    comment: All-pass filter
    value: '[0,]*M+[1,]+[0,]*M'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [616, 288.0]
    rotation: 0
    state: enabled
- name: bw
  id: variable
  parameters:
    comment: 'Bandwidth of

      filter'
    value: 200e3
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 272.0]
    rotation: 0
    state: enabled
- name: complex_bpf
  id: variable
  parameters:
    comment: ''
    value: np.multiply(lpf,complex_shift)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [776, 288.0]
    rotation: 0
    state: enabled
- name: complex_shift
  id: variable
  parameters:
    comment: ''
    value: np.exp(2j*np.pi*n*f/samp_rate)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1312, 48.0]
    rotation: 0
    state: enabled
- name: f
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 0,0,1,20
    label: Filter Frequency (Hz)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: -samp_rate/2
    step: 10e3
    stop: samp_rate/2
    value: '0'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [32, 136.0]
    rotation: 0
    state: enabled
- name: impulse
  id: variable
  parameters:
    comment: 'Generate impulses for testing

      filter frequency responses'
    value: '[0,]*int(N/2)+[N,]+[0,]*int((N/2)-1)'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [304, 136.0]
    rotation: 0
    state: enabled
- name: limit_high
  id: variable
  parameters:
    comment: 'Value: f+(bw/2)'
    value: f+(bw/2)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [400, 272.0]
    rotation: 0
    state: enabled
- name: limit_low
  id: variable
  parameters:
    comment: 'Value: f-(bw/2)'
    value: f-(bw/2)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [296, 272.0]
    rotation: 0
    state: enabled
- name: lpf
  id: variable
  parameters:
    comment: ''
    value: np.multiply(sinc_fixed,w)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1160, 176.0]
    rotation: 0
    state: enabled
- name: n
  id: variable
  parameters:
    comment: ''
    value: np.arange(-M,M+1,1)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [624, 48.0]
    rotation: 0
    state: enabled
- name: num_taps
  id: variable
  parameters:
    comment: ''
    value: '289'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [416, 48.0]
    rotation: 0
    state: enabled
- name: real_bpf
  id: variable
  parameters:
    comment: ''
    value: np.multiply(sinc_bpf,w)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [984, 176.0]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: 2.4e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [208, 48.0]
    rotation: 0
    state: enabled
- name: sinc_bpf
  id: variable
  parameters:
    comment: ''
    value: np.subtract(sinc_high,sinc_low)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [808, 176.0]
    rotation: 0
    state: enabled
- name: sinc_fixed
  id: variable
  parameters:
    comment: ''
    value: 2*(bw/2)/samp_rate*np.sinc(2*n*(bw/2)/samp_rate)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1136, 48.0]
    rotation: 0
    state: enabled
- name: sinc_high
  id: variable
  parameters:
    comment: 'Sinc curve for high frequency

      limit.'
    value: 2*(limit_high)/samp_rate*np.sinc(2*n*(limit_high)/samp_rate)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [968, 48.0]
    rotation: 0
    state: enabled
- name: sinc_low
  id: variable
  parameters:
    comment: 'Sinc curve for low frequency

      limit.'
    value: 2*(limit_low)/samp_rate*np.sinc(2*n*(limit_low)/samp_rate)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [792, 48.0]
    rotation: 0
    state: enabled
- name: w
  id: variable
  parameters:
    comment: Create window
    value: window.hamming(num_taps)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [616, 176.0]
    rotation: 0
    state: enabled

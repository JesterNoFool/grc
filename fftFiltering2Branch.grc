options:
  parameters:
    author: Gary Schafer
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: ''
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: fftFiltering2Branch
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: FFT Filtering by Parts - 2 Branches
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: N
  id: variable
  parameters:
    comment: ''
    value: 2**tapsExponent
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [488, 40.0]
    rotation: 0
    state: enabled
- name: lpf
  id: variable
  parameters:
    comment: 'Create lowpass filter taps


      Value: firdes.low_pass(1,samp_rate,100e3,20e3,5)'
    value: firdes.low_pass(1,samp_rate,100e3,20e3,5)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [296, 36.0]
    rotation: 0
    state: true
- name: lpfFft
  id: variable
  parameters:
    comment: 'Calculate the FFT of the

      zeropadded filter taps.'
    value: np.fft.fft(lpfZero)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [984, 36.0]
    rotation: 0
    state: true
- name: lpfLength
  id: variable
  parameters:
    comment: 'Value: len(lpf)'
    value: len(lpf)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [704, 36.0]
    rotation: 0
    state: enabled
- name: lpfZero
  id: variable
  parameters:
    comment: Zeropad the filter taps
    value: lpf+[0,]*int(N-lpfLength)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [824, 36.0]
    rotation: 0
    state: true
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: 2.4e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [184, 36.0]
    rotation: 0
    state: enabled
- name: tapsExponent
  id: variable
  parameters:
    comment: ''
    value: int(np.log(lpfLength)/np.log(2))+2
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1136, 40.0]
    rotation: 0
    state: enabled

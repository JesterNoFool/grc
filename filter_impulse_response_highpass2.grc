options:
  parameters:
    author: Gary Schafer
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: ''
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: filter_impulse_response_highpass2
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Highpass using Spectrum Reversal
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [56, 16.0]
    rotation: 0
    state: enabled

blocks:
- name: M
  id: variable
  parameters:
    comment: 'Used to create symmetric

      counter around 0.

      ----------------------------------

      Value: int((filt_length-1)/2)'
    value: int((filt_length-1)/2)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [584, 48.0]
    rotation: 0
    state: enabled
- name: N
  id: variable
  parameters:
    comment: ''
    value: 2**14
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [232, 128.0]
    rotation: 0
    state: enabled
- name: cutoff
  id: variable
  parameters:
    comment: 'Cutoff frequency

      of highpass filter'
    value: 300e3
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [760, 40.0]
    rotation: 0
    state: enabled
- name: filt_length
  id: variable
  parameters:
    comment: "Number of taps to\nuse creating the filter.\nThis corresponds to\na\
      \ harris approximation\ncalculation using a \ntransition width of\n20 kHz with\
      \ a 2.4 MHz\nsample rate and Hamming\nwindow."
    value: '289'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [416, 48.0]
    rotation: 0
    state: enabled
- name: freq_shift
  id: variable
  parameters:
    comment: 'Frequency shift by

      Nyquist frequency

      --------------------------

      (-1)**np.abs(n)'
    value: (-1)**np.abs(n)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [896, 304.0]
    rotation: 0
    state: enabled
- name: gain
  id: variable
  parameters:
    comment: Calculate the gain.
    value: np.sum(lpf_win)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [896, 464.0]
    rotation: 0
    state: enabled
- name: grc_hpf
  id: variable_high_pass_filter_taps
  parameters:
    beta: '6.76'
    comment: ''
    cutoff_freq: cutoff
    gain: '1.0'
    samp_rate: samp_rate
    value: ''
    width: 20e3
    win: window.WIN_HAMMING
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [64, 332.0]
    rotation: 0
    state: enabled
- name: high_freq
  id: variable
  parameters:
    comment: 'Frequency of lowpass

      filter before performing

      spectrum reversal'
    value: (samp_rate/2)-cutoff
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [760, 168.0]
    rotation: 0
    state: enabled
- name: hpf
  id: variable
  parameters:
    comment: 'Normalize the gain

      of the filter.'
    value: hpf_win/gain
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1088, 464.0]
    rotation: 0
    state: enabled
- name: hpf_win
  id: variable
  parameters:
    comment: 'Create HPF by frequency

      shifting the LPF.'
    value: np.multiply(freq_shift,lpf_win)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1088, 304.0]
    rotation: 0
    state: enabled
- name: lpf_sinc
  id: variable
  parameters:
    comment: 'Create a lowpass filter at a

      frequency that is the spectral

      reverse of the desired

      highpass filter.'
    value: 2*high_freq*np.sinc(2*n*high_freq/samp_rate)/samp_rate
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [888, 40.0]
    rotation: 0
    state: enabled
- name: lpf_win
  id: variable
  parameters:
    comment: Windowed LPF
    value: np.multiply(lpf_sinc,w)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1088, 192.0]
    rotation: 0
    state: enabled
- name: n
  id: variable
  parameters:
    comment: 'Counter used to

      create sinc curves'
    value: np.arange(-M,M+1,1)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [584, 208.0]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: 2.4e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [232, 48.0]
    rotation: 0
    state: enabled
- name: w
  id: variable
  parameters:
    comment: Window curve
    value: window.hamming(filt_length)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [896, 192.0]
    rotation: 0
    state: enabled

    gui_hint: 0,10,1,10
    label: 'Stopband (kHz): '
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '50'
    step: '0.1'
    stop: '200'
    value: '110'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [840, 8.0]
    rotation: 0
    state: enabled
- name: stopband_atten
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: None
    gui_hint: 4,5,1,5

options:
  parameters:
    author: Gary Schafer
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: 'This flowgraph compares two optimal filters

      (a least squares filter and an equiripple / Remez

      filter) with a windowed-sinc filter using the same

      passband edge, stopband edge, transition

      width, and number of taps.'
    copyright: ''
    description: ''
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: optimalFilter
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Optimal Filters
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: N
  id: variable
  parameters:
    comment: ''
    value: 2**14
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [304, 140.0]
    rotation: 0
    state: true
- name: a
  id: variable
  parameters:
    comment: 'Value: [1,1,0,0]'
    value: '[1,1,0,0]'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [520, 16.0]
    rotation: 0
    state: true
- name: freq
  id: variable
  parameters:
    comment: 'Value: [0,passband*1000,stopband*1000,samp_rate/2]'
    value: '[0,passband*1000,stopband*1000,samp_rate/2]'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [512, 132.0]
    rotation: 0
    state: true
- name: k
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 2,0,1,20
    label: 'Kaiser Beta Value: '
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '1'
    step: '0.05'
    stop: '20'
    value: '4'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [648, 344.0]
    rotation: 0
    state: enabled
- name: ls_freq
  id: variable
  parameters:
    comment: 'Value: [0,passband,stopband,samp_rate/2]'
    value: '[0,passband*1000,stopband*1000,samp_rate/2]'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1200, 136.0]
    rotation: 0
    state: true
- name: lstaps
  id: variable
  parameters:
    comment: 'Value: sig.firls(firtapsLength,freq,a)'
    value: sig.firls(num_taps,ls_freq,a,fs=samp_rate)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1200, 24.0]
    rotation: 0
    state: true
- name: num_taps
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 1,0,1,20
    label: 'Number of taps: '
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: int
    start: '11'
    step: '2'
    stop: '2001'
    value: '201'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1032, 16.0]
    rotation: 0
    state: enabled
- name: optfirTaps
  id: variable
  parameters:
    comment: ''
    value: sig.remez(num_taps,[0, passband*1000, stopband*1000, samp_rate/2], [1,0],fs=samp_rate)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [984, 240.0]
    rotation: 0
    state: true
- name: optfirTapsTrunc
  id: variable
  parameters:
    comment: ''
    value: optfirTaps[1:-1]
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1192, 240.0]
    rotation: 0
    state: true
- name: passband
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 0,0,1,10
    label: Passband (kHz)
    min_len: '200'
    orient: QtCore.Qt.Horizontal

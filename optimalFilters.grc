    value: '40'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [40, 912.0]
    rotation: 0
    state: enabled
- name: stopband_atten_lin
  id: variable
  parameters:
    comment: ''
    value: 10**(-stopband_atten/20)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [208, 920.0]
    rotation: 0
    state: enabled
- name: tap_max
  id: variable
  parameters:

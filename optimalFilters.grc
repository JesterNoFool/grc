    value: 1.2*np.max(optfirTaps)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1360, 240.0]
    rotation: 0
    state: enabled
- name: trans_width
  id: variable
  parameters:
    comment: ''
    value: (stopband-passband)*1000
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [912, 152.0]
    rotation: 0
    state: enabled
- name: win_sinc
  id: variable
  parameters:
    comment: 'Value: sig.firwin(num_taps, (passband*1000), window=(''kaiser'',k),

options:
  parameters:
    author: Gary Schafer
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: ''
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: filter_impulse_response_bandreject
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Bandreject using Spectral Inversion
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [56, 16.0]
    rotation: 0
    state: enabled

blocks:
- name: M
  id: variable
  parameters:
    comment: 'Used to create symmetric

      counter around 0.

      ----------------------------------

      Value: int((filt_length-1)/2)'
    value: int((filt_length-1)/2)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [576, 48.0]
    rotation: 0
    state: enabled
- name: N
  id: variable
  parameters:
    comment: ''
    value: 2**14
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [224, 128.0]
    rotation: 0
    state: enabled
- name: all_pass
  id: variable
  parameters:
    comment: All-pass impulse response
    value: '[0,]*M+[1,]+[0,]*M'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [888, 56.0]
    rotation: 0
    state: enabled
- name: bpf_sinc
  id: variable
  parameters:
    comment: 'Create the bandpass sinc curve

      by subtracting low frequency

      sinc curve from the high

      frequency sinc curve.'
    value: np.subtract(sinc_high,sinc_low)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1080, 184.0]
    rotation: 0
    state: enabled
- name: bpf_win
  id: variable
  parameters:
    comment: 'Window the bandpass

      filter for comparison

      purposes with the band

      reject filter.'
    value: np.multiply(bpf_sinc,w)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1264, 184.0]
    rotation: 0
    state: enabled
- name: brf
  id: variable
  parameters:
    comment: 'Create the final band

      reject filter by normalizing

      the gain of the windowed BRF.'
    value: brf_win/gain
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1072, 544.0]
    rotation: 0
    state: enabled
- name: brf_sinc
  id: variable
  parameters:
    comment: 'Transform bandpass sinc

      curve into band reject sinc

      curve by subtracting

      prototype bandpass

      filter impulse response

      from all-pass impulse response.'
    value: np.subtract(all_pass,bpf_sinc)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1080, 344.0]
    rotation: 0
    state: enabled
- name: brf_win
  id: variable
  parameters:
    comment: 'Window the band reject

      sinc curve.'
    value: np.multiply(brf_sinc,w)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1264, 344.0]
    rotation: 0
    state: enabled
- name: cutoff_high
  id: variable
  parameters:
    comment: 'High frequency

      limit'
    value: 200e3
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [752, 184.0]
    rotation: 0
    state: enabled
- name: cutoff_low
  id: variable
  parameters:
    comment: 'Low frequency

      limit'
    value: 100e3
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [752, 56.0]
    rotation: 0
    state: enabled
- name: filt_length
  id: variable
  parameters:
    comment: "Number of taps to\nuse creating the filter.\nThis corresponds to\na\
      \ harris approximation\ncalculation using a \ntransition width of\n20 kHz with\
      \ a 2.4 MHz\nsample rate and Hamming\nwindow."
    value: '289'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [416, 48.0]
    rotation: 0
    state: enabled
- name: gain
  id: variable
  parameters:
    comment: 'Calculate the gain

      of the windowed

      band reject filter.'
    value: np.sum(brf_win)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [888, 544.0]
    rotation: 0
    state: enabled
- name: grc_brf
  id: variable_band_reject_filter_taps
  parameters:
    beta: '6.76'
    comment: 'Gnu Radio Companion

      band reject filter

      for comparison.'
    gain: '1.0'
    high_cutoff_freq: 200e3
    low_cutoff_freq: 100e3
    samp_rate: samp_rate
    type: band_reject
    value: ''
    width: 20e3
    win: window.WIN_HAMMING
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [64, 300.0]
    rotation: 0
    state: enabled
- name: n
  id: variable
  parameters:
    comment: 'Counter used to

      create sinc curves'
    value: np.arange(-M,M+1,1)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [576, 208.0]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: 2.4e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [232, 48.0]
    rotation: 0
    state: enabled
- name: sinc_high
  id: variable
  parameters:
    comment: 'High frequency sinc curve

      impulse response'
    value: 2*cutoff_high*np.sinc(2*n*cutoff_high/samp_rate)/samp_rate
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [888, 344.0]
    rotation: 0
    state: enabled
- name: sinc_low
  id: variable
  parameters:
    comment: 'Low frequency sinc curve

      impulse response'
    value: 2*cutoff_low*np.sinc(2*n*cutoff_low/samp_rate)/samp_rate
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [888, 184.0]
    rotation: 0
    state: enabled
- name: w
  id: variable
  parameters:
    comment: Window curve
    value: window.hamming(filt_length)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1072, 56.0]
    rotation: 0
    state: enabled

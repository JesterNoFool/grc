options:
  parameters:
    author: Gary Schafer
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: ''
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: filter_impulse_response_highpass
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Highpass using Spectral Inversion
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [56, 16.0]
    rotation: 0
    state: enabled

blocks:
- name: M
  id: variable
  parameters:
    comment: 'Used to create symmetric

      counter around 0.

      ----------------------------------

      Value: int((filt_length-1)/2)'
    value: int((filt_length-1)/2)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [592, 48.0]
    rotation: 0
    state: enabled
- name: N
  id: variable
  parameters:
    comment: ''
    value: 2**14
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [232, 136.0]
    rotation: 0
    state: enabled
- name: all_pass
  id: variable
  parameters:
    comment: 'Impulse used to

      create all-pass filter'
    value: '[0,]*M+[1,]+[0,]*M'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1008, 40.0]
    rotation: 0
    state: enabled
- name: cutoff
  id: variable
  parameters:
    comment: Cutoff frequency
    value: 300e3
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [800, 40.0]
    rotation: 0
    state: enabled
- name: filt_length
  id: variable
  parameters:
    comment: "Number of taps to\nuse creating the filter.\nThis corresponds to\na\
      \ harris approximation\ncalculation using a \ntransition width of\n20 kHz with\
      \ a 2.4 MHz\nsample rate and Hamming\nwindow."
    value: '289'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [424, 48.0]
    rotation: 0
    state: enabled
- name: freq_shift
  id: variable
  parameters:
    comment: 'Half sample rate

      frequency shift

      for calculating the

      gain.'
    value: (-1)**(n+M)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1016, 440.0]
    rotation: 0
    state: enabled
- name: grc_hpf
  id: variable_high_pass_filter_taps
  parameters:
    beta: '6.76'
    comment: 'Gnu Radio Companion

      highpass filter taps'
    cutoff_freq: cutoff
    gain: '1.0'
    samp_rate: samp_rate
    value: ''
    width: 20e3
    win: window.WIN_HAMMING
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [56, 284.0]
    rotation: 0
    state: enabled
- name: hpf
  id: variable
  parameters:
    comment: 'Final highpass filter

      with normalized gain'
    value: hpf_win/hpf_gain
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1304, 432.0]
    rotation: 0
    state: enabled
- name: hpf_gain
  id: variable
  parameters:
    comment: 'Calculate the gain of the

      highpass filter by first

      frequency shifting then

      summing all of the shifted

      taps.'
    value: np.sum(np.multiply(hpf_win,freq_shift))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1152, 440.0]
    rotation: 0
    state: enabled
- name: hpf_sinc
  id: variable
  parameters:
    comment: 'Highpass sinc curve

      by subtracting LP sinc

      curve from impulse'
    value: np.subtract(all_pass,sinc)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1008, 160.0]
    rotation: 0
    state: enabled
- name: hpf_win
  id: variable
  parameters:
    comment: 'Window the highpass

      sinc curve'
    value: np.multiply(hpf_sinc,w)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1208, 312.0]
    rotation: 0
    state: enabled
- name: lpf
  id: variable
  parameters:
    comment: 'Window the lowpass

      filter for comparison

      with the highpass'
    value: np.multiply(sinc,w)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1224, 32.0]
    rotation: 0
    state: enabled
- name: n
  id: variable
  parameters:
    comment: 'Counter used to

      create sinc curves'
    value: np.arange(-M,M+1,1)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [592, 216.0]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: 2.4e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [232, 48.0]
    rotation: 0
    state: enabled
- name: sinc
  id: variable
  parameters:
    comment: 'Lowpass prototype

      sinc curve'
    value: 2*cutoff*np.sinc(2*n*cutoff/samp_rate)/samp_rate
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [800, 144.0]
    rotation: 0
    state: enabled
- name: w
  id: variable
  parameters:
    comment: Create the window
    value: window.hamming(filt_length)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1008, 312.0]
    rotation: 0
    state: enabled

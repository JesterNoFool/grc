options:
  parameters:
    author: Gary Schafer
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: ''
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: filter_impulse_response_highpass
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Create a Bandpass Filter by Frequency-Shifting a Lowpass Filter
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [48, 16.0]
    rotation: 0
    state: enabled

blocks:
- name: M
  id: variable
  parameters:
    comment: 'Used to create symmetric

      counter around 0.

      ----------------------------------

      Value: int((filt_length-1)/2)'
    value: int((filt_length-1)/2)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [624, 40.0]
    rotation: 0
    state: enabled
- name: N
  id: variable
  parameters:
    comment: ''
    value: 2**14
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [232, 136.0]
    rotation: 0
    state: enabled
- name: bpf
  id: variable
  parameters:
    comment: 'Final bandpass filter

      by normalizing the

      gain of the windowed

      bandpass filter.'
    value: bpf_win/gain
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1152, 416.0]
    rotation: 0
    state: enabled
- name: bpf_win
  id: variable
  parameters:
    comment: 'Window the bandpass

      sinc curve.'
    value: np.multiply(freq_shift,lpf_win)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1160, 280.0]
    rotation: 0
    state: enabled
- name: cutoff_high
  id: variable
  parameters:
    comment: 'High frequency

      limit'
    value: 250e3
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [816, 160.0]
    rotation: 0
    state: enabled
- name: cutoff_low
  id: variable
  parameters:
    comment: 'Low frequency

      limit'
    value: 100e3
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [816, 40.0]
    rotation: 0
    state: enabled
- name: filt_length
  id: variable
  parameters:
    comment: "Number of taps to\nuse creating the filter.\nThis corresponds to\na\
      \ harris approximation\ncalculation using a \ntransition width of\n20 kHz with\
      \ a 2.4 MHz\nsample rate and Hamming\nwindow."
    value: '289'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [432, 40.0]
    rotation: 0
    state: enabled
- name: freq_shift
  id: variable
  parameters:
    comment: 'Frequency shift used

      to calculate the gain

      of the bandpass filter.'
    value: 2*np.cos(np.pi*n*(cutoff_low+cutoff_high)/samp_rate)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [952, 280.0]
    rotation: 0
    state: enabled
- name: gain
  id: variable
  parameters:
    comment: 'Calculate the gain of

      the frequency-shifted

      bandpass filter.'
    value: np.sum(lpf_win)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [952, 416.0]
    rotation: 0
    state: enabled
- name: grc_bpf
  id: variable_band_pass_filter_taps
  parameters:
    beta: '6.76'
    comment: 'Gnu Radio Companion

      bandpass filter taps

      for comparison.'
    gain: '1.0'
    high_cutoff_freq: cutoff_high
    low_cutoff_freq: cutoff_low
    samp_rate: samp_rate
    type: band_pass
    value: ''
    width: 20e3
    win: window.WIN_HAMMING
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [56, 308.0]
    rotation: 0
    state: enabled
- name: lpf_cutoff
  id: variable
  parameters:
    comment: ''
    value: (cutoff_high-cutoff_low)/2
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [960, 40.0]
    rotation: 0
    state: enabled
- name: lpf_win
  id: variable
  parameters:
    comment: 'Window the lowpass

      filter.'
    value: np.multiply(sinc_low,w)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1136, 160.0]
    rotation: 0
    state: enabled
- name: n
  id: variable
  parameters:
    comment: 'Counter used to

      create sinc curves'
    value: np.arange(-M,M+1,1)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [624, 192.0]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: 2.4e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [232, 48.0]
    rotation: 0
    state: enabled
- name: sinc_low
  id: variable
  parameters:
    comment: 'Lowpass sinc curve

      for calculated

      half-bandwidth

      frequency.'
    value: 2*lpf_cutoff*np.sinc(2*n*lpf_cutoff/samp_rate)/samp_rate
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1136, 32.0]
    rotation: 0
    state: enabled
- name: w
  id: variable
  parameters:
    comment: Window curve
    value: window.hamming(filt_length)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [952, 160.0]
    rotation: 0
    state: enabled

options:
  parameters:
    author: Gary Schafer
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: ''
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: windowedSincImpulseResponse
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Windowed-Sinc Impulse Response
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: N
  id: variable
  parameters:
    comment: ''
    value: 2**14
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [400, 40.0]
    rotation: 0
    state: true
- name: beta
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 1,0,1,20
    label: 'Kaiser Beta: '
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '1'
    step: '0.05'
    stop: '20'
    value: '4'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [736, 240.0]
    rotation: 0
    state: enabled
- name: fir_taps
  id: variable
  parameters:
    comment: ''
    value: sig.firwin(num_taps,passband*1000,window=('kaiser',beta),fs=samp_rate)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [688, 40.0]
    rotation: 0
    state: enabled
- name: grc_taps
  id: variable
  parameters:
    comment: ''
    value: firdes.low_pass(1,samp_rate,passband*1000,trans_width*1000,0)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [520, 40.0]
    rotation: 0
    state: enabled
- name: num_taps
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: None
    gui_hint: 2,10,1,5
    label: 'Number of Taps: '
    type: int
    value: len(grc_taps)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [856, 32.0]
    rotation: 0
    state: enabled
- name: passband
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 0,0,1,10
    label: Passband (kHz)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '50'
    step: '0.1'
    stop: '200'
    value: '90'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1000, 32.0]
    rotation: 0
    state: enabled
- name: passband_atten
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: None
    gui_hint: 2,0,1,5
    label: 'Required passband attenuation (dB): '
    type: real
    value: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [88, 368.0]
    rotation: 0
    state: enabled
- name: passband_atten_lin
  id: variable
  parameters:
    comment: ''
    value: 10**(-passband_atten/20)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [256, 384.0]
    rotation: 0
    state: enabled
- name: samp_rate
